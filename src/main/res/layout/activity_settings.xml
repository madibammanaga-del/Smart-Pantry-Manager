<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Measurement unit"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <Spinner
            android:id="@+id/spinnerMeasurementUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry reminder"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show ingredients as expiring soon this many days before their expiry date."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp"/>

        <Spinner
            android:id="@+id/spinnerExpiryDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Smart Pantry Manager"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your pantry, keep track of ingredients, and discover recipes using what you have."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</ScrollView>

